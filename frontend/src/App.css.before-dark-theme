  flex-direction: column;
  gap: 3px;
  min-width: 0;
}

.live-threat-row strong {
  overflow: hidden;
  color: #334155;
  font-size: 11px;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
