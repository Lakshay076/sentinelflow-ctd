.protocol-grid > div {
  padding: 13px;
  border: 1px solid #edf2f7;
  border-radius: 8px;
  background: #f8fafc;
}

.protocol-grid span {
  display: block;
  margin-bottom: 5px;
  color: #64748b;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.35px;
  text-transform: uppercase;
