* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
  background: #f4f7fb;
  color: #172033;
}

button {
  font: inherit;
}

.app {
  min-height: 100vh;
}

.topbar {
  height: 76px;
  padding: 0 42px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-bottom: 1px solid #e5e9f0;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-icon {
  width: 42px;
  height: 42px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #172033;
  color: white;
}

.brand h1 {
  margin: 0;
  font-size: 20px;
  letter-spacing: 0.04em;
}

.brand span {
  color: #7a8497;
  font-size: 12px;
}

.topbar-right {
  display: flex;
  align-items: center;
  gap: 20px;
}

.ingest-badge {
  display: flex;
  align-items: center;
  gap: 6px;
  background: #f0f4ff;
  color: #2b57e6;
  border: 1px solid #d4e0fc;
  padding: 6px 12px;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.03em;
}

.system-status {
  display: flex;
  align-items: center;
  gap: 9px;
  font-size: 12px;
  font-weight: 700;
  color: #687386;
}

.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
}

.status-dot.healthy {
  background: #20a66a;
  box-shadow: 0 0 0 4px #e5f7ef;
}

.status-dot.offline {
  background: #d94b4b;
  box-shadow: 0 0 0 4px #fbeaea;
}

.refresh-button {
  margin-left: 8px;
  width: 34px;
  height: 34px;
  border: 1px solid #e1e6ee;
  border-radius: 8px;
  background: white;
  color: #536074;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s ease;
}

.refresh-button:hover {
  background: #f8fafc;
  border-color: #cbd5e1;
}

.dashboard {
  width: 100%;
  max-width: none;
  margin: 0;
  padding: 28px 32px 40px;
}

.page-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24px;
  margin-bottom: 24px;
}

.page-heading h2 {
  margin: 0 0 6px 0;
  font-size: 24px;
  font-weight: 700;
}

.page-heading p {
  margin: 0;
  color: #687386;
  font-size: 14px;
}

.heading-actions {
  display: flex;
  align-items: center;
  gap: 16px;
}

.updated {
  font-size: 12px;
  color: #8c97aa;
}

.test-panel-toggle {
  display: flex;
  align-items: center;
  gap: 6px;
  background: white;
  border: 1px solid #dcdfe6;
  padding: 8px 14px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 600;
  color: #40485a;
  cursor: pointer;
  transition: all 0.15s ease;
}

.test-panel-toggle:hover {
  background: #f8fafc;
  border-color: #cbd5e1;
}

/* Stats Grid */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin-bottom: 24px;
}

.stat-card {
  background: white;
  border: 1px solid #e5e9f0;
  border-radius: 12px;
  padding: 20px;
  display: flex;
  align-items: center;
  gap: 16px;
}

.stat-card.danger {
  border-color: #fca5a5;
  background: #fffafa;
}

.stat-card.danger .stat-icon {
  background: #fee2e2;
  color: #dc2626;
}

.stat-card.highlight {
  border-color: #93c5fd;
  background: #f8fbff;
}

.stat-card.highlight .stat-icon {
  background: #dbeafe;
  color: #2563eb;
}

.stat-icon {
  width: 44px;
  height: 44px;
  border-radius: 10px;
  background: #f1f5f9;
  color: #475569;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stat-card span {
  display: block;
  font-size: 12px;
  color: #64748b;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.stat-card strong {
  display: block;
  font-size: 24px;
  font-weight: 700;
  color: #0f172a;
  margin-top: 2px;
}

/* Demo Lab */
.demo-section {
  margin-bottom: 20px;
}

.demo-intro {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 16px 18px;
  margin-bottom: 14px;
  border: 1px solid #dfe7f1;
  border-radius: 10px;
  background: #f8fafc;
}

.demo-intro strong {
  display: block;
  margin-bottom: 4px;
  color: #1e293b;
  font-size: 14px;
  font-weight: 750;
}

.demo-intro p {
  margin: 0;
  max-width: 760px;
  color: #64748b;
  font-size: 12px;
  line-height: 1.55;
}

.demo-readonly-status {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  flex-shrink: 0;
  padding: 7px 10px;
  border: 1px solid #bfdbfe;
  border-radius: 7px;
  background: #eff6ff;
  color: #1d4ed8;
  font-size: 10px;
  font-weight: 750;
  letter-spacing: 0.05em;
}

/* Threat vectors */
.demo-vector-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
}

.demo-vector-btn {
  display: flex;
  align-items: center;
  gap: 11px;
  width: 100%;
  min-height: 66px;
  padding: 10px 12px;
  border: 1px solid #dfe7f1;
  border-radius: 10px;
  background: #ffffff;
  color: #1e293b;
  text-align: left;
  cursor: pointer;
  transition: border-color 0.15s ease, background 0.15s ease,
    box-shadow 0.15s ease, transform 0.15s ease;
}

.demo-vector-btn:hover:not(:disabled) {
  border-color: #bfdbfe;
  background: #f8fbff;
  box-shadow: 0 3px 10px rgba(30, 64, 175, 0.05);
  transform: translateY(-1px);
}

.demo-vector-btn:disabled {
  opacity: 0.58;
  cursor: not-allowed;
}

.demo-vector-btn.is-running {
  border-color: #93c5fd;
  background: #eff6ff;
}

.demo-vector-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  flex-shrink: 0;
  border-radius: 8px;
}

.demo-vector-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
  gap: 3px;
}

.demo-vector-copy strong {
  overflow: hidden;
  color: #1e293b;
  font-size: 12px;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.demo-vector-copy small {
  color: #94a3b8;
  font-size: 10px;
  font-weight: 600;
}

.demo-vector-action {
  flex-shrink: 0;
  color: #2563eb;
  font-size: 11px;
  font-weight: 700;
}

/* PCAP controls */
.demo-control-row {
  display: flex;
  align-items: flex-end;
  gap: 10px;
  flex-wrap: wrap;
  padding: 16px;
  border: 1px solid #dfe7f1;
  border-radius: 10px;
  background: #ffffff;
}

.demo-select-group {
  display: flex;
  flex-direction: column;
  gap: 5px;
  min-width: 170px;
}

.demo-select-group label {
  color: #64748b;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.demo-select-group select {
  height: 36px;
  min-width: 170px;
  padding: 0 10px;
  border: 1px solid #cbd5e1;
  border-radius: 7px;
  outline: none;
  background: #f8fafc;
  color: #1e293b;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
}

.demo-select-group select:focus {
  border-color: #93c5fd;
}

.demo-primary-btn,
.demo-secondary-btn,
.demo-reset-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  height: 36px;
  padding: 0 13px;
  border-radius: 7px;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.15s ease, border-color 0.15s ease;
}

.demo-primary-btn {
  border: 1px solid #bfdbfe;
  background: #eff6ff;
  color: #1d4ed8;
}

.demo-primary-btn:hover:not(:disabled) {
  background: #dbeafe;
}

.demo-secondary-btn {
  border: 1px solid #cbd5e1;
  background: #ffffff;
  color: #334155;
}

.demo-secondary-btn:hover:not(:disabled) {
  border-color: #94a3b8;
  background: #f8fafc;
}

.demo-reset-btn {
  border: 1px solid #fecdd3;
  background: #fff1f2;
  color: #be123c;
}

.demo-reset-btn:hover:not(:disabled) {
  background: #ffe4e6;
}

.demo-primary-btn:disabled,
.demo-secondary-btn:disabled,
.demo-reset-btn:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

.demo-message {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 10px;
  padding: 9px 12px;
  border: 1px solid #bae6fd;
  border-radius: 7px;
  background: #f0f9ff;
  color: #0369a1;
  font-size: 12px;
  font-weight: 600;
}

/* Benchmark */
.demo-kpi-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  border: 1px solid #dfe7f1;
  border-radius: 10px;
  overflow: hidden;
  background: #ffffff;
}

.demo-kpi {
  min-width: 0;
  padding: 15px 16px;
  border-right: 1px solid #e8edf3;
}

.demo-kpi:last-child {
  border-right: none;
}

.demo-kpi span,
.demo-score-grid span {
  display: block;
  margin-bottom: 5px;
  color: #64748b;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.05em;
}

.demo-kpi strong {
  display: block;
  overflow: hidden;
  color: #172033;
  font-size: 19px;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.demo-kpi strong small {
  color: #64748b;
  font-size: 11px;
  font-weight: 600;
}

.demo-kpi.highlight strong {
  color: #2563eb;
}

/* Validation */
.demo-score-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-bottom: 12px;
  border: 1px solid #dfe7f1;
  border-radius: 10px;
  overflow: hidden;
  background: #ffffff;
}

.demo-score-grid > div {
  padding: 15px 18px;
  border-right: 1px solid #e8edf3;
}

.demo-score-grid > div:last-child {
  border-right: none;
}

.demo-score-grid strong {
  display: block;
  color: #172033;
  font-size: 23px;
  font-weight: 750;
}

.demo-validation-table {
  overflow-x: auto;
  border: 1px solid #dfe7f1;
  border-radius: 10px;
  background: #ffffff;
}

.demo-validation-table table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
}

.demo-validation-table th,
.demo-validation-table td {
  padding: 10px 13px;
  border-bottom: 1px solid #e8edf3;
  text-align: left;
}

.demo-validation-table tr:last-child td {
  border-bottom: none;
}

.demo-validation-table th {
  color: #64748b;
  background: #f8fafc;
  font-size: 10px;
  font-weight: 750;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.demo-validation-table td {
  color: #334155;
}

.demo-validation-table td:first-child {
  color: #1e293b;
  font-weight: 650;
}

.demo-caught,
.demo-missed {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 3px 7px;
  border-radius: 5px;
  font-size: 10px;
  font-weight: 750;
}

.demo-caught {
  background: #dcfce7;
  color: #15803d;
}

.demo-missed {
  background: #fee2e2;
  color: #b91c1c;
}

/* Lab controls */
.demo-management-row {
  display: flex;
  align-items: center;
  gap: 8px;
  padding-top: 2px;
}

@media (max-width: 1000px) {
  .demo-vector-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .demo-kpi-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .demo-kpi:nth-child(3) {
    border-right: none;
  }

  .demo-kpi:nth-child(n + 4) {
    border-top: 1px solid #e8edf3;
  }
}

@media (max-width: 720px) {
  .demo-intro {
    align-items: flex-start;
    flex-direction: column;
  }

  .demo-vector-grid {
    grid-template-columns: 1fr;
  }

  .demo-kpi-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .demo-kpi {
    border-right: 1px solid #e8edf3;
  }

  .demo-kpi:nth-child(even) {
    border-right: none;
  }

  .demo-kpi:nth-child(n + 3) {
    border-top: 1px solid #e8edf3;
  }

  .demo-score-grid {
    grid-template-columns: 1fr;
  }

  .demo-score-grid > div {
    border-right: none;
    border-bottom: 1px solid #e8edf3;
  }

  .demo-score-grid > div:last-child {
    border-bottom: none;
  }

  .demo-control-row {
    align-items: stretch;
    flex-direction: column;
  }

  .demo-select-group,
  .demo-select-group select {
    width: 100%;
  }

  .demo-primary-btn,
  .demo-secondary-btn,
  .demo-reset-btn {
    width: 100%;
  }

  .demo-management-row {
    flex-wrap: wrap;
  }
}

/* Detector Matrix Section */
.detector-matrix-section {
  margin-bottom: 24px;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.section-header h3 {
  margin: 0 0 4px 0;
  font-size: 18px;
  font-weight: 700;
}

.section-header p {
  margin: 0;
  font-size: 13px;
  color: #64748b;
}

.section-header-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.count-badge {
  background: #f1f5f9;
  color: #475569;
  padding: 4px 10px;
  border-radius: 12px;
  font-size: 12px;
  font-weight: 700;
}

.count-badge.danger-badge {
  background: #fee2e2;
  color: #dc2626;
}

.detectors-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 16px;
}

.detector-card {
  background: white;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  padding: 16px;
  cursor: pointer;
  transition: all 0.15s ease;
}

.detector-card:hover {
  border-color: #cbd5e1;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
}

.detector-card.has-active {
  border-color: #fca5a5;
  background: #fffafa;
}

.detector-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.detector-icon-wrapper {
  width: 36px;
  height: 36px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.detector-status-pill {
  font-size: 10px;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: 12px;
  letter-spacing: 0.04em;
}

.pill-online {
  background: #f0fdf4;
  color: #16a34a;
  border: 1px solid #bbf7d0;
}

.pill-danger {
  background: #fef2f2;
  color: #ef4444;
  border: 1px solid #fecaca;
}

.detector-card h4 {
  margin: 0 0 6px 0;
  font-size: 15px;
  font-weight: 700;
  color: #1e293b;
}

.detector-card p {
  margin: 0 0 14px 0;
  font-size: 12px;
  color: #64748b;
  line-height: 1.4;
  min-height: 34px;
}

.detector-card-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid #f1f5f9;
  padding-top: 10px;
  font-size: 12px;
  color: #64748b;
}

.detector-card-bottom strong {
  font-size: 14px;
  color: #0f172a;
}

/* Filter Tabs */
.filter-tabs {
  display: flex;
  gap: 8px;
  margin-bottom: 20px;
  overflow-x: auto;
  padding-bottom: 4px;
}

.filter-tab {
  background: white;
  border: 1px solid #e2e8f0;
  padding: 7px 14px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 600;
  color: #475569;
  cursor: pointer;
  white-space: nowrap;
  transition: all 0.15s ease;
}

.filter-tab.active {
  background: #0f172a;
  color: white;
  border-color: #0f172a;
}

/* Content Section / Alert Cards */
.content-section {
  background: white;
  border: 1px solid #e2e8f0;
  border-radius: 14px;
  padding: 24px;
  margin-bottom: 24px;
}

.resolve-threats-btn-small {
  display: flex;
  align-items: center;
  gap: 4px;
  background: #fee2e2;
  color: #b91c1c;
  border: none;
  padding: 4px 10px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
}

.clear-history-btn-secondary {
  display: flex;
  align-items: center;
  gap: 4px;
  background: #f1f5f9;
  color: #475569;
  border: none;
  padding: 4px 10px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
}

.empty-state {
  text-align: center;
  padding: 40px 20px;
  color: #94a3b8;
}

.empty-state svg {
  color: #22c55e;
  margin-bottom: 12px;
}

.empty-state h4 {
  margin: 0 0 6px 0;
  font-size: 16px;
  color: #1e293b;
}

.empty-state p {
  margin: 0;
  font-size: 13px;
  color: #64748b;
}

.alert-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.alert-card {
  display: flex;
  gap: 16px;
  border: 1px solid #fecaca;
  background: #fffafa;
  border-radius: 10px;
  padding: 16px;
}

.alert-icon {
  width: 44px;
  height: 44px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.alert-main {
  flex: 1;
}

.alert-title {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 8px;
  flex-wrap: wrap;
}

.alert-title strong {
  font-size: 16px;
  color: #0f172a;
}

.attack-code-tag {
  background: #f1f5f9;
  color: #475569;
  font-family: monospace;
  font-size: 11px;
  padding: 2px 6px;
  border-radius: 4px;
}

.alert-meta {
  display: flex;
  gap: 16px;
  font-size: 13px;
  color: #475569;
  margin-bottom: 10px;
  flex-wrap: wrap;
}

.reasons {
  background: #f8fafc;
  border-radius: 6px;
  padding: 10px 14px;
  font-size: 12px;
}

.reasons span {
  display: block;
  font-weight: 700;
  color: #334155;
  margin-bottom: 4px;
}

.reasons ul {
  margin: 0;
  padding-left: 18px;
  color: #475569;
}

.reasons li {
  margin-bottom: 2px;
}

/* Badges */
.badge {
  font-size: 11px;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: 6px;
  text-transform: uppercase;
}

.badge.severity-high {
  background: #fee2e2;
  color: #b91c1c;
}
.badge.severity-medium {
  background: #fef3c7;
  color: #b45309;
}
.badge.severity-low {
  background: #f1f5f9;
  color: #475569;
}

.badge.status-active {
  background: #fee2e2;
  color: #dc2626;
}
.badge.status-resolved {
  background: #f0fdf4;
  color: #16a34a;
}

/* Table */
.table-wrapper {
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}

th,
td {
  padding: 12px 14px;
  text-align: left;
  border-bottom: 1px solid #f1f5f9;
}

th {
  background: #f8fafc;
  font-weight: 600;
  color: #64748b;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

td.source {
  font-family: monospace;
  font-weight: 600;
  color: #1e293b;
}

.confidence-cell {
  display: flex;
  align-items: center;
  gap: 8px;
}

.confidence-mini-bar {
  width: 50px;
  height: 6px;
  background: #e2e8f0;
  border-radius: 3px;
  overflow: hidden;
}

.confidence-mini-bar div {
  height: 100%;
  background: #2563eb;
  border-radius: 3px;
}

/* Attack Summary Breakdown */
.attack-summary {
  background: white;
  border: 1px solid #e2e8f0;
  border-radius: 14px;
  padding: 24px;
}

.attack-summary h3 {
  margin: 0 0 16px 0;
  font-size: 18px;
  font-weight: 700;
}

.attack-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.attack-row {
  display: grid;
  grid-template-columns: 200px 1fr 90px;
  align-items: center;
  gap: 16px;
}

.attack-row-label {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 600;
  color: #334155;
}

.attack-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
}

.attack-bar {
  height: 8px;
  background: #f1f5f9;
  border-radius: 4px;
  overflow: hidden;
}

.attack-bar div {
  height: 100%;
  border-radius: 4px;
}

.attack-row strong {
  text-align: right;
  font-size: 13px;
}

.attack-row small {
  color: #64748b;
  font-weight: 400;
}

/* Footer */
footer {
  text-align: center;
  padding: 24px;
  color: #94a3b8;
  font-size: 12px;
  border-top: 1px solid #e2e8f0;
