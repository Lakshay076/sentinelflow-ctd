  font-size: 12px;
  line-height: 1.55;
}

.intel-status {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
  padding: 8px 0 8px 14px;
  border-left: 3px solid #22c55e;
}

.intel-status svg {
  color: #2563eb;
}

.intel-status div {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.intel-status strong {
  color: #172033;
  font-size: 10px;
  font-weight: 750;
  letter-spacing: 0.08em;
}

.intel-status span {
  color: #94a3b8;
  font-size: 10px;
}

/* Threat KPI strip */

.intel-hero + .stats-grid {
  margin-bottom: 25px;
}

.intel-hero + .stats-grid,
.intel-intro + .stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}

.intel-intro + .stats-grid .stat-card {
  min-height: 82px;
  border: 1px solid #dfe7f1;
  border-radius: 11px;
  background: #ffffff;
  box-shadow: 0 3px 12px rgba(30, 64, 175, 0.04);
}

/* Detection coverage */

.intel-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 10px;
  border-top: 1px solid #dfe7f1;
}

.intel-card {
  position: relative;
  min-height: 0;
  padding: 17px 22px 16px 20px;
  border: 0;
  border-right: 1px solid #dfe7f1;
  border-bottom: 1px solid #dfe7f1;
  border-radius: 0;
  background: transparent;
  transition: background 0.15s ease;
}

.intel-card:nth-child(3n) {
  border-right: 0;
}

.intel-card:hover {
  transform: none;
  background: #f8fbff;
}

.intel-card::before {
  content: "";
  position: absolute;
  top: 18px;
  left: 0;
  width: 3px;
  height: 28px;
  border-radius: 0 2px 2px 0;
  background: #cbd5e1;
}

.intel-card:nth-child(1)::before,
.intel-card:nth-child(2)::before,
.intel-card:nth-child(3)::before,
.intel-card:nth-child(6)::before {
  background: #ef4444;
}

.intel-card:nth-child(4)::before,
.intel-card:nth-child(5)::before {
  background: #f59e0b;
}

.intel-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14px;
}

.intel-card-top > div {
  min-width: 0;
}

.intel-card-top h4 {
  margin: 7px 0 0;
  color: #1e293b;
  font-size: 14px;
  font-weight: 750;
}

.intel-card-top > strong {
  margin-top: 1px;
  color: #334155;
  font-size: 17px;
  font-weight: 750;
}

.intel-card p {
  max-width: 390px;
  min-height: 0;
  margin: 10px 0 13px;
  color: #64748b;
  font-size: 11px;
  line-height: 1.5;
}

.severity-badge {
  display: inline-flex;
  align-items: center;
  padding: 3px 6px;
  border-radius: 3px;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.1em;
}

.severity-badge.high {
  color: #dc2626;
  background: #fef2f2;
}

.severity-badge.medium {
  color: #d97706;
  background: #fffbeb;
}

.intel-evidence {
  display: block;
  padding-top: 9px;
  border-top: 1px solid #e8edf3;
}

.intel-evidence span {
  display: block;
  margin-bottom: 4px;
  color: #94a3b8;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.1em;
}

.intel-evidence strong {
  color: #334155;
  font-size: 10px;
  font-weight: 650;
}

/* Source intelligence */

.intel-source-list {
  overflow: hidden;
  border-top: 1px solid #dfe7f1;
  border-bottom: 1px solid #dfe7f1;
  border-radius: 0;
  background: transparent;
}

.intel-source-row {
  display: grid;
  grid-template-columns: minmax(180px, 1fr) 125px 100px 70px;
  align-items: center;
  gap: 18px;
  padding: 13px 4px;
  border-bottom: 1px solid #e8edf3;
}

.intel-source-row:last-child {
  border-bottom: 0;
}

.intel-source-row > div:first-child {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.intel-source-row > div:first-child strong {
  color: #172033;
  font-family: monospace;
  font-size: 12px;
}

.intel-source-row > div:first-child span {
  color: #94a3b8;
  font-size: 9px;
}

.intel-source-evidence {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.intel-source-evidence span {
  color: #94a3b8;
  font-size: 8px;
  font-weight: 750;
  letter-spacing: 0.09em;
}

.intel-source-evidence strong {
  color: #334155;
  font-size: 11px;
}

/* Latest evidence */

.intel-evidence-table {
  overflow: hidden;
  border-top: 1px solid #dfe7f1;
  border-bottom: 1px solid #dfe7f1;
  border-radius: 0;
  background: transparent;
}

.evidence-row {
  display: grid;
  grid-template-columns: 180px 1fr 65px;
  align-items: center;
  gap: 18px;
  padding: 12px 4px;
  border-bottom: 1px solid #e8edf3;
}

.evidence-row:last-child {
  border-bottom: 0;
}

.evidence-row > div:first-child {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.evidence-row > div:first-child strong {
  color: #1e293b;
  font-size: 11px;
}

.evidence-row > div:first-child span {
  color: #94a3b8;
  font-family: monospace;
  font-size: 9px;
}

.evidence-reasons {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.evidence-reasons span {
  color: #64748b;
  font-size: 10px;
  line-height: 1.4;
}

.evidence-row > strong {
  color: #2563eb;
  text-align: right;
  font-size: 12px;
}

/* Empty state */

.empty-state.compact {
  padding: 25px 12px;
  border-bottom: 1px solid #dfe7f1;
  border-radius: 0;
  background: transparent;
}

/* Responsive */

@media (max-width: 1050px) {
  .intel-intro + .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .intel-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .intel-card:nth-child(3n) {
    border-right: 1px solid #dfe7f1;
  }

  .intel-card:nth-child(2n) {
    border-right: 0;
  }
}

@media (max-width: 760px) {
  .intel-intro {
    align-items: flex-start;
    flex-direction: column;
  }

  .intel-status {
    width: 100%;
    box-sizing: border-box;
  }

  .intel-intro + .stats-grid {
    grid-template-columns: 1fr 1fr;
  }

  .intel-grid {
    grid-template-columns: 1fr;
  }

  .intel-card,
  .intel-card:nth-child(2n),
  .intel-card:nth-child(3n) {
    border-right: 0;
  }

  .intel-source-row {
    grid-template-columns: 1fr 1fr;
  }

  .evidence-row {
    grid-template-columns: 1fr;
    gap: 8px;
  }

  .evidence-row > strong {
    text-align: left;
  }
}

/* =========================================================
   ANALYTICS
   ========================================================= */

.analytics-intro {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 20px;
}

.analytics-intro h2 {
  margin: 5px 0 6px;
  color: #172033;
  font-size: 23px;
  font-weight: 750;
  line-height: 1.2;
}

.analytics-intro p {
  max-width: 780px;
  margin: 0;
  color: #64748b;
  font-size: 12px;
  line-height: 1.55;
}

.analytics-window-status {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
  padding: 8px 0 8px 14px;
  border-left: 3px solid #22c55e;
}

.analytics-window-status > div {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.analytics-window-status strong {
  color: #172033;
  font-size: 10px;
  font-weight: 750;
  letter-spacing: 0.08em;
}

.analytics-window-status span:last-child {
  color: #94a3b8;
  font-size: 10px;
}

/* KPI strip */

.analytics-kpi-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  margin-bottom: 25px;
  border-top: 1px solid #dfe7f1;
  border-bottom: 1px solid #dfe7f1;
}

.analytics-kpi {
  min-width: 0;
  padding: 14px 15px;
  border-right: 1px solid #dfe7f1;
}

.analytics-kpi:last-child {
  border-right: 0;
}

.analytics-kpi span {
  display: block;
  margin-bottom: 6px;
  color: #64748b;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
}

.analytics-kpi strong {
  display: block;
  color: #172033;
  font-size: 21px;
  font-weight: 750;
  line-height: 1.1;
}

.analytics-kpi small {
  display: block;
  margin-top: 5px;
  color: #94a3b8;
  font-size: 9px;
}

/* Section headers */

.analytics-section {
  margin-bottom: 24px;
}

.analytics-section-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 10px;
}

.analytics-section-header h3 {
  margin: 3px 0 0;
  color: #1e293b;
  font-size: 15px;
  font-weight: 750;
}

.analytics-section-header > span {
  color: #94a3b8;
  font-size: 10px;
}

/* Packet chart */

.analytics-chart {
  position: relative;
  display: flex;
  align-items: flex-end;
  gap: 3px;
  height: 185px;
  padding: 12px 4px 0;
  overflow: hidden;
  border-top: 1px solid #dfe7f1;
  border-bottom: 1px solid #dfe7f1;

  background:
    linear-gradient(
      to bottom,
      transparent 24%,
      #f1f5f9 25%,
      transparent 25.5%
    ),
    linear-gradient(
      to bottom,
      transparent 49%,
      #f1f5f9 50%,
      transparent 50.5%
    ),
    linear-gradient(
      to bottom,
      transparent 74%,
      #f1f5f9 75%,
      transparent 75.5%
    );
}

.analytics-bar-column {
  flex: 1 1 0;
  min-width: 2px;
  height: 100%;
  display: flex;
  align-items: flex-end;
}

.analytics-bar {
  width: 100%;
  min-height: 3px;
  border-radius: 3px 3px 0 0;
  background: #60a5fa;
  opacity: 0.88;
  transition: height 0.25s ease, opacity 0.2s ease;
}

.analytics-bar:hover {
  opacity: 1;
  background: #2563eb;
}

.analytics-empty {
  width: 100%;
  align-self: center;
  text-align: center;
  color: #94a3b8;
  font-size: 11px;
}

.analytics-axis {
  display: flex;
  justify-content: space-between;
  padding: 7px 4px 0;
  color: #94a3b8;
  font-size: 9px;
}

/* Protocol + scope */

.analytics-two-column {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 28px;
  margin-bottom: 24px;
}

.analytics-panel {
  min-width: 0;
}

.protocol-analytics {
  border-top: 1px solid #dfe7f1;
  border-bottom: 1px solid #dfe7f1;
}

.protocol-analytics-row {
  display: grid;
  grid-template-columns: 135px 1fr 55px;
  align-items: center;
  gap: 14px;
  padding: 11px 0;
  border-bottom: 1px solid #e8edf3;
}

.protocol-analytics-row:last-child {
  border-bottom: 0;
}

.protocol-analytics-label {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.protocol-analytics-label strong {
  color: #1e293b;
  font-size: 11px;
  font-weight: 700;
}

.protocol-analytics-label span {
  color: #94a3b8;
  font-size: 9px;
}

.protocol-analytics-row > strong {
  color: #334155;
  text-align: right;
  font-size: 11px;
}

.protocol-analytics-track,
.detection-analytics-track {
  height: 6px;
  overflow: hidden;
  border-radius: 3px;
  background: #eef2f7;
}

.protocol-analytics-fill,
.detection-analytics-fill {
  height: 100%;
  border-radius: inherit;
  background: #60a5fa;
  transition: width 0.3s ease;
}

/* Network scope */

.scope-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  border-top: 1px solid #dfe7f1;
  border-bottom: 1px solid #dfe7f1;
}

.scope-grid > div {
  padding: 11px 14px;
  border-right: 1px solid #e8edf3;
  border-bottom: 1px solid #e8edf3;
}

.scope-grid > div:nth-child(2n) {
  border-right: 0;
}

.scope-grid > div:nth-last-child(-n + 2) {
  border-bottom: 0;
}

.scope-grid span {
  display: block;
  margin-bottom: 5px;
  color: #94a3b8;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
}

.scope-grid strong {
  color: #172033;
  font-size: 14px;
  font-weight: 750;
}

/* Detection distribution */

.detection-analytics {
  border-top: 1px solid #dfe7f1;
  border-bottom: 1px solid #dfe7f1;
}

.detection-analytics-row {
  display: grid;
  grid-template-columns: 185px 1fr 45px;
  align-items: center;
  gap: 16px;
  padding: 10px 0;
  border-bottom: 1px solid #e8edf3;
}

.detection-analytics-row:last-child {
  border-bottom: 0;
}

.detection-analytics-name {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.detection-analytics-name strong {
  color: #1e293b;
  font-size: 11px;
}

.detection-analytics-name span {
  color: #94a3b8;
  font-family: monospace;
  font-size: 8px;
}

.detection-analytics-row > strong {
  color: #334155;
  text-align: right;
  font-size: 12px;
}

/* Bottom summary */

.analytics-footer-summary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 6px;
  border-top: 1px solid #dfe7f1;
  border-bottom: 1px solid #dfe7f1;
}

.analytics-footer-summary > div {
  padding: 13px 15px;
  border-right: 1px solid #dfe7f1;
}

.analytics-footer-summary > div:last-child {
  border-right: 0;
}

.analytics-footer-summary span {
  display: block;
  margin-bottom: 4px;
  color: #94a3b8;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.analytics-footer-summary strong {
  color: #172033;
  font-size: 17px;
  font-weight: 750;
}

/* Responsive */

@media (max-width: 1150px) {
  .analytics-kpi-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .analytics-kpi:nth-child(3) {
    border-right: 0;
  }

  .analytics-two-column {
    grid-template-columns: 1fr;
    gap: 20px;
  }
}

@media (max-width: 760px) {
  .analytics-intro {
    align-items: flex-start;
    flex-direction: column;
  }

  .analytics-window-status {
    width: 100%;
    box-sizing: border-box;
  }

  .analytics-kpi-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .analytics-kpi:nth-child(3) {
    border-right: 1px solid #dfe7f1;
  }

  .analytics-kpi:nth-child(2n) {
    border-right: 0;
  }

  .protocol-analytics-row {
    grid-template-columns: 105px 1fr 45px;
  }

  .detection-analytics-row {
    grid-template-columns: 125px 1fr 35px;
    gap: 10px;
  }
}


/* =========================================================
   ABOUT MONI
   Product / Architecture presentation
   ========================================================= */

.about-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 32px;
  padding: 28px 30px;
  margin-bottom: 20px;
  border: 1px solid #dfe7f1;
  border-radius: 12px;
  background: #ffffff;
}

.about-hero-copy {
  max-width: 780px;
}

.about-hero-copy h2 {
  margin: 7px 0 10px;
  max-width: 760px;
  color: #172033;
  font-size: 27px;
  line-height: 1.2;
  font-weight: 780;
  letter-spacing: -0.025em;
}

.about-hero-copy p {
  max-width: 720px;
  margin: 0;
  color: #64748b;
  font-size: 13px;
  line-height: 1.7;
}

.about-hero-status {
  display: flex;
  align-items: center;
  gap: 11px;
  min-width: 210px;
  padding: 13px 15px;
  border: 1px solid #bfdbfe;
  border-radius: 9px;
  background: #eff6ff;
  color: #2563eb;
}

.about-hero-status strong {
  display: block;
  margin-bottom: 3px;
  color: #1d4ed8;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.05em;
}

.about-hero-status span {
  display: block;
  color: #64748b;
  font-size: 10px;
  font-weight: 600;
}

/* Mission */
.about-mission {
  max-width: 950px;
  padding: 18px 20px;
  border-left: 3px solid #2563eb;
  background: #f8fafc;
}

.about-mission p {
  margin: 0;
  color: #475569;
  font-size: 13px;
  line-height: 1.75;
}

/* Architecture flow */
.about-flow {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border: 1px solid #dfe7f1;
  border-radius: 10px;
  overflow: hidden;
  background: #ffffff;
}

.about-flow-item {
  position: relative;
  min-width: 0;
  padding: 19px 18px;
  border-right: 1px solid #e8edf3;
}

.about-flow-item:last-child {
  border-right: none;
}

.about-flow-number {
  margin-bottom: 12px;
  color: #2563eb;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.08em;
}

.about-flow-copy strong {
  display: block;
  margin-bottom: 6px;
  color: #1e293b;
  font-size: 13px;
  font-weight: 750;
}

.about-flow-copy p {
  margin: 0;
  color: #64748b;
  font-size: 11px;
  line-height: 1.65;
}

/* Design principles */
.about-principles {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1px;
  border: 1px solid #dfe7f1;
  border-radius: 10px;
  overflow: hidden;
  background: #dfe7f1;
}

.about-principle {
  display: flex;
  gap: 13px;
  min-height: 112px;
  padding: 18px;
  background: #ffffff;
}

.about-principle-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  flex-shrink: 0;
  border-radius: 8px;
  background: #eff6ff;
  color: #2563eb;
}

.about-principle h4 {
  margin: 1px 0 5px;
  color: #1e293b;
  font-size: 13px;
  font-weight: 750;
}

.about-principle p {
  max-width: 500px;
  margin: 0;
  color: #64748b;
  font-size: 11px;
  line-height: 1.65;
}

/* Threat coverage */
.about-threats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border: 1px solid #dfe7f1;
  border-radius: 10px;
  overflow: hidden;
  background: #ffffff;
}

.about-threat {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 58px;
  padding: 12px 15px;
  border-right: 1px solid #e8edf3;
  border-bottom: 1px solid #e8edf3;
}

.about-threat:nth-child(3n) {
  border-right: none;
}

.about-threat:nth-last-child(-n + 3) {
  border-bottom: none;
}

.about-threat span {
  color: #94a3b8;
  font-size: 10px;
  font-weight: 750;
  letter-spacing: 0.05em;
}

.about-threat strong {
  color: #334155;
  font-size: 12px;
  font-weight: 650;
}

/* Deployment */
.about-deployment {
  border: 1px solid #dfe7f1;
  border-radius: 10px;
  background: #ffffff;
  overflow: hidden;
}

.about-deployment-path {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24px;
  padding: 25px 24px;
}

.deployment-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 210px;
  padding: 17px;
  border: 1px solid #dfe7f1;
  border-radius: 9px;
  background: #f8fafc;
  text-align: center;
}

.deployment-node svg {
  margin-bottom: 8px;
  color: #64748b;
}

.deployment-node strong {
  color: #1e293b;
  font-size: 12px;
  font-weight: 750;
}

.deployment-node span {
  margin-top: 4px;
  color: #94a3b8;
  font-size: 10px;
}

.deployment-node.active {
  border-color: #bfdbfe;
  background: #eff6ff;
}

.deployment-node.active svg {
  color: #2563eb;
}

.deployment-connector {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 130px;
  gap: 7px;
}

.deployment-connector span {
  color: #2563eb;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.07em;
}

.deployment-connector div {
  width: 100%;
  height: 1px;
  background: #93c5fd;
}

.about-deployment-note {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 11px 15px;
  border-top: 1px solid #e8edf3;
  background: #f8fafc;
}

.about-deployment-note svg {
  flex-shrink: 0;
  color: #64748b;
}

.about-deployment-note p {
  margin: 0;
  color: #64748b;
  font-size: 11px;
}

/* Footer statement */
.about-footer-note {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;
  margin-top: 20px;
  padding: 20px 22px;
  border: 1px solid #dfe7f1;
  border-radius: 10px;
  background: #ffffff;
}

.about-footer-note h3 {
  margin: 6px 0 7px;
  color: #1e293b;
  font-size: 15px;
  font-weight: 750;
}

.about-footer-note p {
  max-width: 820px;
  margin: 0;
  color: #64748b;
  font-size: 11px;
  line-height: 1.65;
}

.about-footer-badge {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
  color: #2563eb;
  font-size: 14px;
  font-weight: 800;
  letter-spacing: 0.06em;
}

/* About responsive */
@media (max-width: 1000px) {
  .about-hero {
    align-items: flex-start;
    flex-direction: column;
  }

  .about-hero-status {
    width: 100%;
  }

  .about-flow {
    grid-template-columns: repeat(2, 1fr);
  }

  .about-flow-item:nth-child(2) {
    border-right: none;
  }

  .about-flow-item:nth-child(n + 3) {
    border-top: 1px solid #e8edf3;
  }

  .about-principles {
    grid-template-columns: 1fr;
  }

  .about-threats {
    grid-template-columns: repeat(2, 1fr);
  }

  .about-threat:nth-child(3n) {
    border-right: 1px solid #e8edf3;
  }

  .about-threat:nth-child(2n) {
    border-right: none;
  }

  .about-threat:nth-last-child(-n + 3) {
    border-bottom: 1px solid #e8edf3;
  }

  .about-threat:nth-last-child(-n + 2) {
    border-bottom: none;
  }
}

@media (max-width: 720px) {
  .about-hero {
    padding: 20px;
  }

  .about-hero-copy h2 {
    font-size: 22px;
  }

  .about-flow {
    grid-template-columns: 1fr;
  }

  .about-flow-item {
    border-right: none;
    border-bottom: 1px solid #e8edf3;
  }

  .about-flow-item:last-child {
    border-bottom: none;
  }

  .about-threats {
    grid-template-columns: 1fr;
  }

  .about-threat {
    border-right: none !important;
    border-bottom: 1px solid #e8edf3 !important;
  }

  .about-threat:last-child {
    border-bottom: none !important;
  }

  .about-deployment-path {
    flex-direction: column;
  }

  .deployment-connector {
    width: 100%;
  }

  .deployment-connector div {
    width: 1px;
    height: 28px;
  }

  .deployment-node {
    width: 100%;
  }

  .about-footer-note {
    align-items: flex-start;
    flex-direction: column;
  }
}
