# Unified database configuration shared by alerts/alert_store.py and telemetry/live_metrics.py
# auto     = PostgreSQL if DATABASE_URL is valid, with automatic SQLite fallback on connection failure
# postgres = Explicit PostgreSQL mode (requires valid DATABASE_URL; fails rather than falling back to SQLite)
# sqlite   = Explicit SQLite development/demo mode (ignores DATABASE_URL)
# CTD_DB_STRICT=true fails at startup even in 'auto' mode if PostgreSQL is unconfigured/unavailable
DATABASE_URL=postgresql://ctd_user:YOUR_PASSWORD@localhost:5432/ctd
# CTD_DB_BACKEND=auto
# CTD_DB_STRICT=false

