/* =========================================================
   THREAT INTELLIGENCE
   ========================================================= */

.intel-intro {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 20px;
}

.intel-intro > div:first-child {
