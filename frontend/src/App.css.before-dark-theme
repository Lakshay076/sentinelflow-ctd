.live-threat-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.live-threat-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 11px 12px;
  border: 1px solid #edf2f7;
  border-radius: 8px;
  background: #fafcff;
