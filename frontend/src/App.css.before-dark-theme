.traffic-chart-column {
  flex: 1 1 0;
  min-width: 2px;
  height: 100%;
  display: flex;
  align-items: flex-end;
}

.traffic-chart-bar {
  width: 100%;
  min-height: 3px;
  border-radius: 3px 3px 0 0;
  background: #60a5fa;
  opacity: 0.88;
  transition: height 0.35s ease, opacity 0.2s ease;
}

.traffic-chart-column:hover .traffic-chart-bar {
  opacity: 1;
}

.traffic-chart-empty {
  width: 100%;
  align-self: center;
  text-align: center;
  color: #94a3b8;
