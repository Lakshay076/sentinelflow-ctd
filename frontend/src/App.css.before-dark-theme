  gap: 5px;
  padding: 8px 12px;
  border-radius: 8px;
  background: #f0f7ff;
}

.live-chart-current strong {
  color: #2563eb;
  font-size: 20px;
  font-weight: 750;
}

.live-chart-current span {
  color: #64748b;
  font-size: 10px;
  font-weight: 650;
}

.traffic-chart {
  position: relative;
  display: flex;
  align-items: flex-end;
  gap: 3px;
  height: 230px;
  padding: 18px 4px 0;
  overflow: hidden;
  border-bottom: 1px solid #e2e8f0;
  background:
    linear-gradient(to bottom, transparent 24%, #f1f5f9 25%, transparent 25.5%),
